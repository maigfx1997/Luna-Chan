        async function autoPasteUrl() {
            try {
                const text = await navigator.clipboard.readText();
                if (text) {
                    const urlMatch = text.match(/https?:\/\/[^\s]+/);
                    document.getElementById('novel-url').value = urlMatch ? urlMatch[0] : text.trim();
                }
            } catch (err) {
                alert(currentLang === 'ar' ? 'يرجى السماح بالوصول للحافظة أو اللصق يدوياً.' : 'Please allow clipboard permission or paste manually.');
