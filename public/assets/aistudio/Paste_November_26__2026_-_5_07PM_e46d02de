        function checkIncomingShare() {
            const params = new URLSearchParams(window.location.search);
            const sharedUrl = params.get('url') || params.get('text') || params.get('title');
            if (sharedUrl) {
                const urlMatch = sharedUrl.match(/https?:\/\/[^\s]+/);
                const cleanUrl = urlMatch ? urlMatch[0] : sharedUrl;
                document.getElementById('novel-url').value = cleanUrl;
                // تنظيف الرابط من شريط العنوان وبدء الجلب تلقائياً
                window.history.replaceState({}, document.title, window.location.pathname);
                fetchNovelFromUrl();
            }
        }

        /* ==========================================================================
           6. محرك جلب واستخراج البيانات والصور من أي رابط (Multi-Proxy DOM Parser)
           ========================================================================== */
        async function fetchWithCorsProxy(targetUrl) {
            const proxies = [
                url => `https://api.allorigins.win/get?url=${encodeURIComponent(url)}`,
                url => `https://corsproxy.io/?${encodeURIComponent(url)}`
            ];

            for (const proxyFn of proxies) {
                try {
                    const res = await fetch(proxyFn(targetUrl));
                    if (!res.ok) continue;
                    const contentType = res.headers.get('content-type') || '';
                    if (contentType.includes('application/json')) {
                        const data = await res.json();
                        if (data.contents) return data.contents;
                    } else {
                        return await res.text();
                    }
                } catch (e) { /* تجربة البروكسي التالي */ }
            }
            throw new Error('CORS_FETCH_FAILED');
        }

        function resolveUrl(base, relative) {
            try { return new URL(relative, base).href; } catch { return relative; }
        }

        async function fetchNovelFromUrl() {
            const urlInput = document.getElementById('novel-url').value.trim();
            if (!urlInput) return;

            const statusBar = document.getElementById('status-bar');
            const statusText = document.getElementById('status-text');
            const statusProgress = document.getElementById('status-progress');

            statusBar.classList.remove('hidden');
            statusText.textContent = i18n[currentLang].fetchingMsg;
            statusProgress.style.width = '35%';

            try {
                const htmlString = await fetchWithCorsProxy(urlInput);
                statusProgress.style.width = '75%';

                const parser = new DOMParser();
                const doc = parser.parseFromString(htmlString, 'text/html');

                // 1. استخراج العنوان الذكي (OpenGraph / H1 / Title)
                const title = doc.querySelector('meta[property="og:title"]')?.content ||
                              doc.querySelector('h1')?.textContent?.trim() ||
                              doc.title || 'Untitled Story';

                // 2. استخراج اسم الكاتب
                const author = doc.querySelector('meta[name="author"]')?.content ||
                               doc.querySelector('[rel="author"], .author, .byline, [class*="author"]')?.textContent?.trim() ||
                               'Unknown Author';

                // 3. استخراج النبذة / الوصف
                const description = doc.querySelector('meta[property="og:description"]')?.content ||
                                    doc.querySelector('meta[name="description"]')?.content ||
                                    doc.querySelector('.summary, .description, .synopsis, [class*="desc"]')?.textContent?.trim() || '';

                // 4. استخراج صورة الغلاف وتحويل روابطها لمسارات مطلقة
                let coverRaw = doc.querySelector('meta[property="og:image"]')?.content ||
                               doc.querySelector('.cover img, [class*="cover"] img, img')?.getAttribute('src');
                const cover = coverRaw ? resolveUrl(urlInput, coverRaw) : defaultCoverSVG;

                // 5. استخراج محتوى الفصول والصور الداخلية
                const chapters = extractChaptersFromDoc(doc, urlInput, title);

                currentNovel = {
                    id: Date.now().toString(),
                    url: urlInput,
                    title: title.trim(),
                    author: author.trim(),
                    description: description.trim(),
                    cover,
                    chapters
                };

                statusProgress.style.width = '100%';
                setTimeout(() => {
                    statusBar.classList.add('hidden');
                    populateWorkspace();
                }, 400);

            } catch (error) {
                statusBar.classList.add('hidden');
                // في حال حظر الموقع للوصول المباشر، نفتح مساحة العمل مع بيانات أولية ليتمكن المستخدم من اللصق/التعديل
                alert(currentLang === 'ar' 
                    ? 'تعذر سحب الصفحة تلقائياً بسبب قيود الحماية في المصدر، تم فتح محرر الكتاب لإدخال المحتوى أو تعديله يدوياً.' 
                    : 'Could not auto-fetch due to source restrictions. Opened editor for manual input.');
                loadSampleNovel(urlInput);
            }
        }

        function extractChaptersFromDoc(doc, baseUrl, fallbackTitle) {
            // إزالة العناصر غير المرغوبة (قوائم، إعلانات، سكربتات)
            doc.querySelectorAll('script, style, nav, header, footer, iframe, .ads, .comments').forEach(el => el.remove());

            // البحث عن حاويات الفصول أو المحتوى الرئيسي
            const chapterNodes = doc.querySelectorAll('.chapter, [class*="chapter-content"], article, .entry-content, #chapter-content, .story-text');
            const extracted = [];

            if (chapterNodes.length > 0) {
                chapterNodes.forEach((node, idx) => {
                    // تحويل جميع الصور داخل الفصل إلى مسارات كاملة والإبقاء عليها
                    node.querySelectorAll('img').forEach(img => {
                        const src = img.getAttribute('data-src') || img.getAttribute('src');
                        if (src) {
                            img.setAttribute('src', resolveUrl(baseUrl, src));
                            img.removeAttribute('srcset');
                        }
                    });

                    const chTitleEl = node.querySelector('h1, h2, h3, .chapter-title');
                    const chTitle = chTitleEl ? chTitleEl.textContent.trim() : `${fallbackTitle} - ${idx + 1}`;
                    if (chTitleEl) chTitleEl.remove();

                    // تنظيف الوسوم مع الحفاظ على الفقرات والصور
                    const cleanHtml = sanitizeChapterHtml(node);
                    if (cleanHtml.trim().length > 20) {
                        extracted.push({
                            id: `ch_${Date.now()}_${idx}`,
                            title: chTitle,
                            htmlContent: cleanHtml
                        });
                    }
                });
            }

            // إذا لم يُعثر على حاوية محددة، نجمع الفقرات والصور من body
            if (extracted.length === 0) {
                const bodyClone = doc.body;
                bodyClone.querySelectorAll('img').forEach(img => {
                    const src = img.getAttribute('data-src') || img.getAttribute('src');
                    if (src) img.setAttribute('src', resolveUrl(baseUrl, src));
                });
                extracted.push({
                    id: `ch_${Date.now()}_0`,
                    title: fallbackTitle,
                    htmlContent: sanitizeChapterHtml(bodyClone)
                });
            }

            return extracted;
        }

        function sanitizeChapterHtml(container) {
            let output = '';
            container.querySelectorAll('p, img, h2, h3, blockquote').forEach(el => {
                if (el.tagName === 'IMG') {
                    const src = el.getAttribute('src');
                    if (src && !src.includes('avatar') && !src.includes('icon')) {
                        output += `<p><img src="${src}" alt="Illustration"></p>\n`;
                    }
                } else {
                    const text = el.innerHTML.trim();
                    if (text) output += `<p>${text}</p>\n`;
                }
            });
            return output || `<p>${container.textContent.trim().replace(/\n+/g, '</p><p>')}</p>`;
        }

