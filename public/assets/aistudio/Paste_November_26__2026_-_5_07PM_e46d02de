<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>لونا تشأن — محول الروايات إلى كتب إلكترونية</title>
    <!-- PWA Manifest المدمج لدعم استقبال المشاركة (Web Share Target) -->
    <link rel="manifest" id="manifest-placeholder">
    
    <!-- المكتبات الخارجية عبر CDN للتشغيل الفوري بدون بناء معقد -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'Quicksand', 'sans-serif'],
                    },
                    colors: {
                        pinky: {
                            50: '#fff0f6',
                            100: '#ffdeeb',
                            200: '#fcc2d7',
                            300: '#faa2c1',
                            400: '#f783ac',
                            500: '#f06595',
                            600: '#e64980',
                            700: '#d6336c',
                            800: '#c2255c',
                            900: '#a61e4d',
                        },
                        darkbg: '#161115',
                        darkcard: '#221a20',
                        darkborder: '#382a34'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        /* تخصيص شريط التمرير الوردي */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #faa2c1; border-radius: 10px; }
        .dark ::-webkit-scrollbar-thumb { background: #a61e4d; }
        
        /* تنسيق محرر الفصول لدعم الصور والنصوص */
        .chapter-editor img {
            max-width: 100%;
            height: auto;
            border-radius: 0.75rem;
            margin: 0.75rem auto;
            display: block;
            box-shadow: 0 4px 12px rgba(240, 101, 149, 0.15);
        }
    </style>
</head>
<body class="bg-pinky-50 text-gray-800 dark:bg-darkbg dark:text-pinky-50 min-h-screen flex flex-col">

    <!-- الشريط العلوي (Header) -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-darkcard/85 border-b border-pinky-200 dark:border-darkborder px-4 py-3 shadow-sm">
        <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <!-- الشعار -->
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-pinky-500 to-pinky-300 flex items-center justify-center text-white font-extrabold text-xl shadow-md shadow-pinky-500/30">
                    🎀
                </div>
                <div>
                    <h1 class="font-extrabold text-lg text-pinky-700 dark:text-pinky-300 leading-tight" data-i18n="appName">لونا تشأن</h1>
                    <p class="text-xs text-pinky-500 dark:text-pinky-400" data-i18n="appTagline">صانع الكتب الإلكترونية</p>
                </div>
            </div>

            <!-- أزرار التحكم: السجل، اللغة، الوضع الليلي -->
            <div class="flex items-center gap-2">
                <button onclick="toggleHistoryModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-pinky-100 hover:bg-pinky-200 dark:bg-darkborder dark:hover:bg-pinky-900/40 text-pinky-700 dark:text-pinky-200 text-sm font-semibold transition">
                    <span>📚</span>
                    <span data-i18n="historyBtn">السجل</span>
                    <span id="history-count" class="bg-pinky-500 text-white text-xs px-1.5 py-0.2 rounded-full">0</span>
                </button>

                <!-- مبدل اللغات -->
                <div class="flex bg-pinky-100 dark:bg-darkborder p-1 rounded-xl text-xs font-bold">
                    <button onclick="setLanguage('ar')" id="lang-ar" class="px-2 py-1 rounded-lg transition">عربي</button>
                    <button onclick="setLanguage('en')" id="lang-en" class="px-2 py-1 rounded-lg transition">EN</button>
                    <button onclick="setLanguage('fr')" id="lang-fr" class="px-2 py-1 rounded-lg transition">FR</button>
                </div>

                <!-- زر الوضع الليلي/النهاري -->
                <button onclick="toggleDarkMode()" id="theme-toggle" class="w-9 h-9 rounded-xl bg-pinky-100 hover:bg-pinky-200 dark:bg-darkborder dark:hover:bg-pinky-900/40 flex items-center justify-center text-lg transition" title="تبديل المظهر">
                    🌙
                </button>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-6 space-y-6">

        <!-- قسم إدخال الرابط والاستيراد -->
        <section class="bg-white dark:bg-darkcard rounded-3xl p-6 shadow-lg shadow-pinky-200/40 dark:shadow-none border border-pinky-100 dark:border-darkborder">
            <div class="text-center max-w-2xl mx-auto mb-5">
                <span class="inline-block px-3 py-1 rounded-full bg-pinky-100 dark:bg-pinky-900/40 text-pinky-600 dark:text-pinky-300 text-xs font-bold mb-2" data-i18n="universalBadge">
                    ✨ يدعم الاستيراد الذكي من مختلف المواقع والروابط بجميع اللغات
                </span>
                <h2 class="text-2xl font-extrabold text-gray-800 dark:text-white mb-1" data-i18n="heroTitle">حوّل قصتك المفضلة إلى كتاب أنيق</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400" data-i18n="heroDesc">ألصق رابط الرواية أو شاركه مباشرة من متصفح هاتفك، عدّل التفاصيل، وحمّله فوراً.</p>
            </div>

            <!-- شريط الإدخال -->
            <div class="flex flex-col sm:flex-row gap-2.5 max-w-3xl mx-auto">
                <div class="relative flex-1 flex items-center">
                    <input type="url" id="novel-url" placeholder="https://..." 
                        class="w-full pl-28 pr-4 py-3.5 rounded-2xl bg-pinky-50/70 dark:bg-darkbg border-2 border-pinky-200 dark:border-darkborder focus:border-pinky-500 focus:outline-none text-sm transition" dir="ltr">
                    
                    <!-- زر اللصق التلقائي بضغطة واحدة -->
                    <button onclick="autoPasteUrl()" type="button" class="absolute left-2 px-3 py-1.5 rounded-xl bg-pinky-200/80 hover:bg-pinky-300 dark:bg-pinky-900/60 dark:hover:bg-pinky-800 text-pinky-800 dark:text-pinky-100 text-xs font-bold flex items-center gap-1 transition">
                        <span>📋</span>
                        <span data-i18n="autoPasteBtn">لصق تلقائي</span>
                    </button>
                </div>

                <button onclick="fetchNovelFromUrl()" id="fetch-btn" class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-pinky-500 to-pinky-600 hover:from-pinky-600 hover:to-pinky-700 text-white font-bold text-sm shadow-md shadow-pinky-500/30 flex items-center justify-center gap-2 transition active:scale-95">
                    <span>🪄</span>
                    <span data-i18n="fetchBtn">جلب الرواية</span>
                </button>
            </div>

            <!-- خيارات إضافية سريعة (إنشاء يدوي / تجريبي) -->
            <div class="mt-3 text-center">
                <button onclick="loadSampleNovel()" class="text-xs text-pinky-500 hover:text-pinky-700 dark:text-pinky-400 underline font-semibold" data-i18n="loadSampleBtn">
                    أو جرّب بقالب رواية جاهز للمعاينة والتعديل الفوري
                </button>
            </div>

            <!-- شريط حالة الجلب -->
            <div id="status-bar" class="hidden mt-4 max-w-3xl mx-auto p-3.5 rounded-2xl bg-pinky-100/70 dark:bg-darkbg border border-pinky-200 dark:border-darkborder text-sm flex items-center gap-3">
                <div class="animate-spin text-xl">🌸</div>
                <div class="flex-1">
                    <p id="status-text" class="font-bold text-pinky-700 dark:text-pinky-300">جاري تحليل الرابط...</p>
                    <div class="w-full bg-pinky-200 dark:bg-darkborder h-1.5 rounded-full mt-1.5 overflow-hidden">
                        <div id="status-progress" class="bg-pinky-500 h-full w-1/3 transition-all duration-300"></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- مساحة العمل: التعديل والمعاينة والتصدير (تظهر بعد جلب البيانات) -->
        <section id="workspace" class="hidden space-y-6 animate-fade-in">
            
            <!-- بطاقة بيانات الكتاب والغلاف -->
            <div class="bg-white dark:bg-darkcard rounded-3xl p-6 shadow-lg shadow-pinky-200/30 dark:shadow-none border border-pinky-100 dark:border-darkborder">
                <div class="flex items-center justify-between border-b border-pinky-100 dark:border-darkborder pb-3 mb-5">
                    <h3 class="font-extrabold text-lg text-pinky-700 dark:text-pinky-300 flex items-center gap-2">
                        <span>📖</span>
                        <span data-i18n="metadataTitle">بيانات الكتاب والغلاف</span>
                    </h3>
                    <span class="text-xs text-gray-400" data-i18n="editHint">جميع الحقول قابلة للتعديل المباشر</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- عمود الغلاف -->
                    <div class="flex flex-col items-center gap-3">
                        <div class="relative w-44 h-64 rounded-2xl overflow-hidden shadow-md border-2 border-pinky-200 dark:border-darkborder bg-pinky-50 dark:bg-darkbg group">
                            <img id="cover-preview" src="" alt="Cover" class="w-full h-full object-cover">
                            <label for="cover-upload" class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white text-xs font-bold cursor-pointer transition">
                                <span class="text-2xl mb-1">🖼️</span>
                                <span data-i18n="changeCover">تغيير الغلاف</span>
                            </label>
                            <input type="file" id="cover-upload" accept="image/*" class="hidden" onchange="handleCoverUpload(event)">
                        </div>
                        <button onclick="document.getElementById('cover-upload').click()" class="text-xs px-3 py-1.5 rounded-xl bg-pinky-100 dark:bg-darkborder text-pinky-700 dark:text-pinky-200 font-bold hover:bg-pinky-200 transition" data-i18n="uploadCoverBtn">
                            رفع صورة غلاف جديدة
                        </button>
                    </div>

                    <!-- عمود النصوص (العنوان، الكاتب، الوصف) -->
                    <div class="md:col-span-2 space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-pinky-600 dark:text-pinky-300 mb-1" data-i18n="bookTitleLabel">عنوان الرواية</label>
                            <input type="text" id="edit-title" class="w-full px-4 py-2.5 rounded-xl bg-pinky-50/50 dark:bg-darkbg border border-pinky-200 dark:border-darkborder focus:border-pinky-500 focus:outline-none font-bold">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-pinky-600 dark:text-pinky-300 mb-1" data-i18n="authorLabel">اسم الكاتب</label>
                            <input type="text" id="edit-author" class="w-full px-4 py-2.5 rounded-xl bg-pinky-50/50 dark:bg-darkbg border border-pinky-200 dark:border-darkborder focus:border-pinky-500 focus:outline-none">
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-bold text-pinky-600 dark:text-pinky-300" data-i18n="descLabel">الوصف / النبذة</label>
                                <button onclick="clearDescription()" class="text-xs text-rose-500 hover:underline font-semibold" data-i18n="deleteDescBtn">🗑️ حذف الوصف</button>
                            </div>
                            <textarea id="edit-desc" rows="4" class="w-full px-4 py-2.5 rounded-xl bg-pinky-50/50 dark:bg-darkbg border border-pinky-200 dark:border-darkborder focus:border-pinky-500 focus:outline-none text-sm leading-relaxed"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- بطاقة إدارة الفصول والصور الداخلية -->
            <div class="bg-white dark:bg-darkcard rounded-3xl p-6 shadow-lg shadow-pinky-200/30 dark:shadow-none border border-pinky-100 dark:border-darkborder">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-pinky-100 dark:border-darkborder pb-3 mb-4">
                    <h3 class="font-extrabold text-lg text-pinky-700 dark:text-pinky-300 flex items-center gap-2">
                        <span>📑</span>
                        <span data-i18n="chaptersTitle">الفصول والمحتوى</span>
                        <span id="chapters-badge" class="text-xs bg-pinky-500 text-white px-2.5 py-0.5 rounded-full">0</span>
                    </h3>

                    <div class="flex items-center gap-2">
                        <button onclick="addNewChapter()" class="px-3 py-1.5 rounded-xl bg-pinky-100 hover:bg-pinky-200 dark:bg-darkborder text-pinky-700 dark:text-pinky-200 text-xs font-bold transition" data-i18n="addChapterBtn">
                            + إضافة فصل جديد
                        </button>
                        <button onclick="openPreviewModal()" class="px-4 py-1.5 rounded-xl bg-pinky-500 hover:bg-pinky-600 text-white text-xs font-bold shadow-sm transition flex items-center gap-1">
                            <span>👁️</span>
                            <span data-i18n="previewBookBtn">معاينة الكتاب</span>
                        </button>
                    </div>
                </div>

                <!-- قائمة الفصول القابلة للتعديل والحذف -->
                <div id="chapters-list" class="space-y-3 max-h-[500px] overflow-y-auto pr-1">
                    <!-- يتم توليد بطاقات الفصول هنا ديناميكياً -->
                </div>
            </div>

            <!-- شريط التصدير والتحميل النهائي (صيغ متعددة للكتب الإلكترونية) -->
            <div class="bg-gradient-to-r from-pinky-500 to-pinky-600 rounded-3xl p-6 text-white shadow-xl shadow-pinky-500/25 flex flex-col md:flex-row items-center justify-between gap-4">
                <div>
                    <h3 class="font-extrabold text-xl" data-i18n="exportTitle">جاهز لتحميل كتابك الإلكتروني!</h3>
                    <p class="text-pinky-100 text-xs mt-0.5" data-i18n="exportDesc">اختر الصيغة المناسبة لجهازك أو قارئك، وسيتم حفظ نسخة تلقائية في السجل.</p>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto justify-center">
                    <button onclick="exportBook('epub')" class="px-4 py-2.5 rounded-2xl bg-white text-pinky-600 hover:bg-pinky-50 font-extrabold text-sm shadow-md transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>📘</span> EPUB
                    </button>
                    <button onclick="exportBook('pdf')" class="px-4 py-2.5 rounded-2xl bg-pinky-800/40 hover:bg-pinky-800/60 border border-white/30 text-white font-extrabold text-sm transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>📕</span> PDF
                    </button>
                    <button onclick="exportBook('fb2')" class="px-4 py-2.5 rounded-2xl bg-pinky-800/40 hover:bg-pinky-800/60 border border-white/30 text-white font-extrabold text-sm transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>📗</span> FB2
                    </button>
                    <button onclick="exportBook('html')" class="px-4 py-2.5 rounded-2xl bg-pinky-800/40 hover:bg-pinky-800/60 border border-white/30 text-white font-extrabold text-sm transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>🌐</span> HTML
                    </button>
                    <button onclick="exportBook('md')" class="px-4 py-2.5 rounded-2xl bg-pinky-800/40 hover:bg-pinky-800/60 border border-white/30 text-white font-extrabold text-sm transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>📝</span> MD
                    </button>
                    <button onclick="exportBook('rtf')" class="px-4 py-2.5 rounded-2xl bg-pinky-800/40 hover:bg-pinky-800/60 border border-white/30 text-white font-extrabold text-sm transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>📃</span> RTF
                    </button>
                    <button onclick="exportBook('txt')" class="px-4 py-2.5 rounded-2xl bg-pinky-800/40 hover:bg-pinky-800/60 border border-white/30 text-white font-extrabold text-sm transition active:scale-95 flex items-center justify-center gap-1.5">
                        <span>📄</span> TXT
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- نافذة المعاينة الكاملة للكتاب (Preview Modal) -->
    <div id="preview-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-darkcard w-full max-w-3xl max-h-[90vh] rounded-3xl shadow-2xl flex flex-col overflow-hidden border border-pinky-200 dark:border-darkborder">
            <div class="px-6 py-4 border-b border-pinky-100 dark:border-darkborder flex items-center justify-between bg-pinky-50/50 dark:bg-darkbg">
                <h3 class="font-extrabold text-pinky-700 dark:text-pinky-300 flex items-center gap-2">
                    <span>👁️</span>
                    <span data-i18n="previewModalTitle">معاينة تنسيق الكتاب</span>
                </h3>
                <button onclick="closePreviewModal()" class="w-8 h-8 rounded-full bg-pinky-100 dark:bg-darkborder text-pinky-700 dark:text-pinky-200 font-bold hover:bg-pinky-200">✕</button>
            </div>
            
            <div id="preview-content" class="p-6 overflow-y-auto space-y-8 text-gray-800 dark:text-gray-200 leading-loose">
                <!-- محتوى المعاينة يولد هنا -->
            </div>

            <div class="px-6 py-3 border-t border-pinky-100 dark:border-darkborder bg-pinky-50/50 dark:bg-darkbg flex justify-end gap-2">
                <button onclick="closePreviewModal()" class="px-5 py-2 rounded-xl bg-pinky-500 text-white text-sm font-bold" data-i18n="closeBtn">إغلاق المعاينة</button>
            </div>
        </div>
    </div>

    <!-- نافذة السجل (History Modal) -->
    <div id="history-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-darkcard w-full max-w-2xl max-h-[85vh] rounded-3xl shadow-2xl flex flex-col overflow-hidden border border-pinky-200 dark:border-darkborder">
            <div class="px-6 py-4 border-b border-pinky-100 dark:border-darkborder flex items-center justify-between bg-pinky-50/50 dark:bg-darkbg">
                <h3 class="font-extrabold text-pinky-700 dark:text-pinky-300 flex items-center gap-2">
                    <span>📚</span>
                    <span data-i18n="historyModalTitle">سجل الروايات المحوّلة سابقاً</span>
                </h3>
                <div class="flex items-center gap-2">
                    <button onclick="clearHistory()" class="text-xs text-rose-500 hover:underline font-bold" data-i18n="clearHistoryBtn">مسح السجل</button>
                    <button onclick="toggleHistoryModal()" class="w-8 h-8 rounded-full bg-pinky-100 dark:bg-darkborder text-pinky-700 dark:text-pinky-200 font-bold">✕</button>
                </div>
            </div>
            
            <div id="history-list" class="p-5 overflow-y-auto space-y-3 flex-1">
                <!-- عناصر السجل -->
            </div>
        </div>
    </div>

    <!-- حاوية مخفية لتوليد PDF -->
    <div id="pdf-render-container" class="hidden"></div>

    <script>
        /* ==========================================================================
           1. إعدادات PWA و Web Share Target لاستقبال الروابط من تطبيقات الهاتف
           ========================================================================== */
        (function setupWebShareTarget() {
            const manifest = {
                name: "لونا تشأن - محول الروايات",
                short_name: "لونا تشأن",
                start_url: window.location.pathname,
                display: "standalone",
                background_color: "#fff0f6",
                theme_color: "#f06595",
                share_target: {
                    action: window.location.pathname,
                    method: "GET",
                    params: {
                        title: "title",
                        text: "text",
                        url: "url"
                    }
                }
            };
            const stringManifest = JSON.stringify(manifest);
            const blob = new Blob([stringManifest], {type: 'application/json'});
            const manifestURL = URL.createObjectURL(blob);
            document.getElementById('manifest-placeholder').setAttribute('href', manifestURL);
        })();

        /* ==========================================================================
           2. نظام الترجمة ثلاثي اللغات (العربية، الإنجليزية، الفرنسية)
           ========================================================================== */
        const i18n = {
            ar: {
                appName: "لونا تشأن",
                appTagline: "صانع الكتب الإلكترونية",
                historyBtn: "السجل",
                universalBadge: "✨ يدعم الاستيراد الذكي من مختلف المواقع والروابط بجميع اللغات",
                heroTitle: "حوّل قصتك المفضلة إلى كتاب أنيق",
                heroDesc: "ألصق رابط الرواية أو شاركه مباشرة من متصفح هاتفك، عدّل التفاصيل، وحمّله فوراً.",
                autoPasteBtn: "لصق تلقائي",
                fetchBtn: "جلب الرواية",
                loadSampleBtn: "أو جرّب بقالب رواية جاهز للمعاينة والتعديل الفوري",
                metadataTitle: "بيانات الكتاب والغلاف",
                editHint: "جميع الحقول قابلة للتعديل المباشر",
                changeCover: "تغيير الغلاف",
                uploadCoverBtn: "رفع صورة غلاف جديدة",
                bookTitleLabel: "عنوان الرواية",
                authorLabel: "اسم الكاتب",
                descLabel: "الوصف / النبذة",
                deleteDescBtn: "🗑️ حذف الوصف",
                chaptersTitle: "الفصول والمحتوى",
                addChapterBtn: "+ إضافة فصل جديد",
                previewBookBtn: "معاينة الكتاب",
